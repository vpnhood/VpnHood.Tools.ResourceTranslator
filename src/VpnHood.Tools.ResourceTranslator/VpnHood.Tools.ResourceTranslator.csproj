<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<AssemblyName>vhtranslator</AssemblyName>
		<RootNamespace>VpnHood.Tools.ResourceTranslator</RootNamespace>
	</PropertyGroup>

	<!-- Ship as a .NET global/local tool: `dotnet tool install -g VpnHood.Tools.ResourceTranslator` -->
	<PropertyGroup>
		<PackAsTool>true</PackAsTool>
		<ToolCommandName>vhtranslator</ToolCommandName>
		<PackageId>VpnHood.Tools.ResourceTranslator</PackageId>
		<Title>VpnHood Resource Translator</Title>
		<Description>AI-powered translator for i18n resource files (JSON, Microsoft .resx) and static Jekyll-style websites. Translates only what changed, preserves placeholders, HTML structure and formatting, verifies every translated page before writing it, and supports Google Gemini, OpenAI and Grok engines.</Description>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="AngleSharp" />
		<PackageReference Include="Microsoft.Extensions.FileSystemGlobbing" />
		<PackageReference Include="Mscc.GenerativeAI" />
		<PackageReference Include="OpenAI" />
		<PackageReference Include="System.CommandLine" />
		<PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="all" />
	</ItemGroup>

	<!-- The default prompt templates travel with the tool. -->
	<ItemGroup>
		<Content Include="Resources\translation-prompt.txt">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
		<Content Include="Resources\site-page-prompt.txt">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
	</ItemGroup>

	<!-- Files referenced by the package metadata in Directory.Build.props. -->
	<ItemGroup>
		<None Include="..\..\README.md" Pack="true" PackagePath="\" Visible="false" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="VpnHood.Tools.ResourceTranslator.Tests" />
	</ItemGroup>

</Project>
